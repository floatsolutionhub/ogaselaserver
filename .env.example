# Copy this file to .env and fill in real values. .env is gitignored - never commit real
# secrets. docker-compose.yml reads these to configure the api container.

# Required - signs/validates every access and refresh token. Generate with `openssl rand -base64 64`.
# Rotating this invalidates every currently-issued token.
JWT_SECRET=
# Optional - a master OTP accepted in place of the generated code for every OTP check (login,
# admin login, password reset, phone/email change). 6 digits. Anyone who knows it can pass any
# account's OTP step, so it is ignored whenever the API runs in the Production environment
# (including when ASPNETCORE_ENVIRONMENT is unset). Each use is logged as a warning.
Default_Global_OTP=
TERMII_API_KEY=
EMAIL_SMTP_KEY=
# Optional: Brevo SMTP port. 2525 by default because many networks block 587.
EMAIL_SMTP_PORT=
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REKOGNITION_FACE_MATCH_THRESHOLD=90
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
# Required - verifies Cloudflare Turnstile tokens submitted by OgaselaWebsite's forms (contact,
# tester signup, deletion requests). The matching public site key lives in OgaselaWebsite's own
# env, never here.
TURNSTILE_SECRET_KEY=
# Optional - push notifications silently no-op until these are set (see PushNotificationChannel).
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional - description generation returns Ai.GenerationFailed until the active provider's key
# is set (Ai:Provider in appsettings picks which one - default "Gemini").
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional - connect/promote calls return AdIntegrations.PlatformRequestFailed until a platform's
# app id/secret are set. RedirectUri (appsettings.json) must match what's registered with each platform.
FACEBOOK_ADS_APP_ID=
FACEBOOK_ADS_APP_SECRET=
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_APP_SECRET=
# Optional - seeds exactly one SuperAdmin account on startup, but only if all four of these are
# set (see SuperAdminSeeder). No-ops if any is missing, or if a user with this phone/email
# already exists. This is the only way to provision the first admin - there's no public signup
# path for internal roles.
SUPERADMIN_SEED_NAME=
SUPERADMIN_SEED_PHONE=
SUPERADMIN_SEED_EMAIL=
SUPERADMIN_SEED_PASSWORD=
# Optional - social sign-in. Each provider answers 503 (SocialLogin.ProviderNotConfigured) until set.
# Google: the OAuth client ids the mobile app uses (Google Cloud Console > Credentials).
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
# Facebook Login: the Meta app's id and secret (the secret never goes in the mobile app).
FACEBOOK_LOGIN_APP_ID=
FACEBOOK_LOGIN_APP_SECRET=
# Apple needs no secret here - tokens are checked against the iOS bundle id
# (SocialAuth:Apple:Audiences in appsettings.json, default com.ogasela.app).
