{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=ogasela;Username=ogasela;Password=ogasela",
    "Redis": "localhost:6379"
  },
  "Verification": {
    "Provider": "Mock"
  },
  // Local-dev-only signing key so `dotnet run`/`dotnet test` work with zero setup. Never used in
  // any real deployment (production has no default - see appsettings.json), and this value is
  // freely rotatable since nothing outside a developer's own machine ever trusts a token it
  // signs.
  "Jwt": {
    "Secret": "4GHJmhZbcP9lfFiR93JxdPVUYy8l8Wbv5NOlIftmPTUkzV+1Bd/Ic1ZsMRJmMbv5H7WMg97y/AnVn4t8VuXmKg=="
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 100000,
    "MessagingPermitsPerMinute": 100000,
    "MarketingPermitsPerMinute": 100000
  },
  // OgaselaWebClient's dev server, and loopback so its local calls carry the visitor's IP.
  "Payments": {
    "AllowedReturnUrls": ["http://localhost:3001/payments/return"]
  },
  "ForwardedHeaders": {
    "KnownProxies": ["127.0.0.1", "::1"]
  },
  "Cors": {
    // OgaselaControlPortalUI's Vite dev server, OgaselaMobileClient's `expo start --web`, and
    // OgaselaWebsite's Next.js dev server.
    "AllowedOrigins": ["http://localhost:5173", "http://localhost:8081", "http://localhost:3000"]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  }
}
